class Producto:

    def __init__(self,codigo: int,nombre: str, categoria: str, precio: float, stock: int):
        self.codigo = codigo
        self.nombre = nombre
        self.categoria = categoria
        self.precio = precio
        self.stock = stock
        self.datos_basicos = (categoria, precio)

    def obtener_categoria(self):
        return self.datos_basicos[0]

    def obtener_precio(self):
        return self.datos_basicos[1]

    def aumentar_stock(self, cantidad):
        if cantidad > 0:
            self.stock += cantidad

    def disminuir_stock(self, cantidad):
        if cantidad > 0 and cantidad <= self.stock:
            self.stock -= cantidad

    def mostrar_informacion(self):
        return "Código: " + str(self.codigo) + " | Nombre: " + self.nombre + " | Categoría: " + self.categoria + " | Precio: " + str(self.obtener_precio()) + " | Stock: " + str(self.stock)

class Inventario:
    def __init__(self, nombre_tienda):
        self.nombre_tienda = nombre_tienda
        self.productos = []
        self.resumen_categorias = {}

    def agregar_producto(self, producto: Producto):
        for p in self.productos:
            if p.codigo == producto.codigo:
                return
        self.productos.append(producto)

    def buscar_producto_por_codigo(self, codigo):
        for producto in self.productos:
            if producto.codigo == codigo:
                return producto
        return None
    
    def listar_productos(self):
        lista_productos = []
        for producto in self.productos:
            lista_productos.append(producto.mostrar_informacion())
        return lista_productos
    
    def mostrar_productos_por_categoria(self,categoria):
        productos_categoria = []
        for producto in self.productos:
            if producto.obtener_categoria() == categoria:
                productos_categoria.append(producto.mostrar_informacion())
        return productos_categoria
    
    def actualizar_resumen_categorias(self):
        self.resumen_categorias = {}
        for producto in self.productos:
            categoria = producto.obtener_categoria()
            if categoria in self.resumen_categorias:
                self.resumen_categorias[categoria] += 1
            else:
                self.resumen_categorias[categoria] = 1
    def mostrar_resumen_categorias(self):
        self.actualizar_resumen_categorias()
        resumen = []
        for categoria in self.resumen_categorias:
            resumen.append("Categoría: " + categoria + " | Cantidad: " + str(self.resumen_categorias[categoria]))
        return resumen

